package com.Hibernate.learn_Hibernate;

import java.sql.Date;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Lob;
import jakarta.persistence.Table;
import jakarta.persistence.Temporal;
import jakarta.persistence.TemporalType;
import jakarta.persistence.Transient;

@Entity()
@Table(name = "st_address")
public class Address {
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY) // autoincrement
	private int addId;

	@Column(length = 50, name = "street_name")
	private String city;

//	@Transient
	private double x;

	@Column(name = "date")
	@Temporal(TemporalType.DATE)
	private Date addedDate;

	@Lob
	private byte[] image;

	// Constructors
	public Address(int addId, String city, double x, Date addedDate, byte[] image) {
		super();
		this.addId = addId;
		this.city = city;
		this.x = x;
		this.addedDate = addedDate;
		this.image = image;
	}

	public Address() {
		super();
		// TODO Auto-generated constructor stub
	}

	public int getAddId() {
		return addId;
	}

	public void setAddId(int addId) {
		this.addId = addId;
	}

	public String getCity() {
		return city;
	}

	public void setCity(String city) {
		this.city = city;
	}

	public double getX() {
		return x;
	}

	public void setX(double x) {
		this.x = x;
	}

	public Date getAddedDate() {
		return addedDate;
	}

	public void setAddedDate(Date addedDate) {
		this.addedDate = addedDate;
	}

	public byte[] getImage() {
		return image;
	}

	public void setImage(String img) {
		FileInputStream fis=new FileInputStrem(img);
		this.image = image;
	}

}
