package feedback_app.session.manage;

import java.io.IOException;
import java.util.UUID;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.Cookie;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;


@WebServlet("/request1")
public class Request1Servlet extends HttpServlet {

	@Override
	protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {
		String username = "Kamlesh";
		String userId = "user01";
//		Cookie cookie = new Cookie("username", username);
//		Cookie cookie2 = new Cookie("userId", userId);
//		cookie.setMaxAge(10 * 60);
//		resp.addCookie(cookie);
//		resp.addCookie(cookie2);
		
		// Http Session

		HttpSession session = req.getSession();
		session.setAttribute("httpSessionSecret", UUID.randomUUID().toString());
		session.setAttribute("username", username);
		session.setAttribute("userId", userId);
		session.setMaxInactiveInterval(10 * 60);

	}

}
