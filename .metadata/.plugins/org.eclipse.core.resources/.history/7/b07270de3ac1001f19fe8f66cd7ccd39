<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
	<display-name>Archetype Created Web Application</display-name>

	<!-- RegisterServlet Mapping -->
	<servlet>
		<servlet-name>Register</servlet-name>
		<servlet-class>com.usermanagement.servlets.RegisterServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Register</servlet-name>
		<url-pattern>/register</url-pattern>
	</servlet-mapping>

	<!-- LoginServlet Mapping -->
	<servlet>
		<servlet-name>Login</servlet-name>
		<servlet-class>servlets</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Login</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>

	<!-- LogoutServlet Mapping -->
	<servlet>
		<servlet-name>Logout</servlet-name>
		<servlet-class>servlets</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Logout</servlet-name>
		<url-pattern>/logout</url-pattern>
	</servlet-mapping>

	<!-- WelcomeServlet Mapping -->
	<servlet>
		<servlet-name>Welcome</servlet-name>
		<servlet-class>com.usermanagement.servlets.WelcomeServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Welcome</servlet-name>
		<url-pattern>/welcome</url-pattern>
	</servlet-mapping>
</web-app>
